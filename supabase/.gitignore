# Supabase
.branches
.temp

# dotenvx
.env.keys
.env.local
.env.*.local

# ---------------------------------------------------------------------
# Local seed'ler: gerçek şirket verisi ve Auth password hash'leri ASLA
# commit edilmez. Yalnız local-only dev login dosyası izinlidir.
#
# NOT: bu kurallar .gitignore'dadır (klonla birlikte gelir), yalnız
# .git/info/exclude'da değildir (o dosya klonlanmaz).
# ---------------------------------------------------------------------
seeds/*
!seeds/10_local_dev_auth.sql
# Sprint 01: synthetic dev -> team mapping. Contains no real identity and
# no company data, so it is safe to commit and is required for a fresh
# clone to have working internal access after the RLS tightening.
!seeds/30_local_identity_mapping.sql
# Sprint 02: provenance mapping replayed after the company-data seed.
# Deterministic mapping logic only - contains no company data.
!seeds/40_s02_provenance_backfill.sql
# Sprint 03: work_parties backfill + legacy phase mapping, replayed after
# the company-data seed. Deterministic logic only - no company data.
!seeds/50_s03_work_backfill.sql
# Upstream reconciliation: mirrors legacy seviye from app_role and
# translates jobs.durum to canonical phase/lifecycle. No company data.
!seeds/97_upstream_compat_backfill.sql
# PS3: contact_affiliations backfill replayed after the company-data seed,
# because db reset runs migrations against an empty database. Deterministic
# logic only - no company data.
!seeds/98_ps3_affiliation_backfill.sql

# PS8: media occupancy_mode for the M1 LED area + deterministic legacy
# exact-period consolidation, replayed after the company-data seed. No
# company data.
!seeds/98_ps8_media_backfill.sql

# Eski düzen (seeds/ öncesi) — geri gelmesin
seed.sql
seed_local_auth.sql

# Salt-okunur remote dump'ları
.dumps/
*.dump
